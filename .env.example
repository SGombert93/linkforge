# Public origin, no trailing path. HTTPS required except localhost.
BASE_URL=https://music.example.com
# Used only by the optional Caddy compose override:
DOMAIN=music.example.com
PORT=8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/linkforge/.well-known/openid-configuration
OIDC_CLIENT_ID=linkforge
OIDC_CLIENT_SECRET=replace-with-provider-client-secret
OIDC_SCOPES=openid profile email
# Dot-separated claim path. Must contain the exact role link_admin.
# Examples: roles ; groups ; realm_access.roles ; resource_access.linkforge.roles
OIDC_ROLE_CLAIM=roles
# id_token (default) or userinfo (verified subject must match the ID token)
OIDC_ROLE_SOURCE=id_token
# Absolute local session lifetime, also capped by ID token expiry.
SESSION_SECONDS=3600
